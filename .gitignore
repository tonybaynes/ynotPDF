# dependencies / build output
node_modules/
dist/
out/
release/
coverage/
.vite/
*.tsbuildinfo

# native binaries fetched at build time (scripts/fetch-binaries.ts) — never committed
resources/bin/**
!resources/bin/README.md

# PDFs are only allowed as synthetic fixtures under test/fixtures/
*.pdf
!test/fixtures/**/*.pdf

# secrets and certificates
.env
.env.*
*.p12
*.pfx
*.key
*.pem

# test artefacts
test-results/
playwright-report/
blob-report/

# editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# husky wrapper scripts (generated by `npm run prepare`)
.githooks/_/
