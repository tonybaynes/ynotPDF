  "presets": [
    {
      "id": "page-numbers",
      "name": "Page numbers",
      "kind": "header-footer",
      "spec": {
        "kind": "header-footer",
        "zones": { "footer-centre": "<<1 of n>>" },
        "font": "Helvetica",
        "size": 9,
        "colour": 0,
        "margins": { "left": 36, "right": 36, "top": 28, "bottom": 28 },
        "underline": false,
        "shrink": 0,
        "startNumber": 1,
        "totalOverride": 0
      }
    },
    {
