          "recompressStreams": true,
          "removeUnused": true,
          "linearise": true
        },
        "dedupe": { "images": true, "fonts": true, "xobjects": true }
      }
    },
    {
      "id": "smallest",
      "name": "Smallest — screen only",
      "description": "As small as this can go. Pictures will look soft, and attachments are dropped.",
      "lossless": false,
      "options": {
        "images": {
          "colour": { "targetDpi": 72, "thresholdDpi": 85, "codec": "jpeg", "quality": 45 },
