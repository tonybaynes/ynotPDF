{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    // M91: the engine half is compiled by `tsconfig.web.json`, but a unit test imports it from
    // here, so its ambient declarations (utif) have to be visible to this project too.
    "src/engine/**/*.d.ts",
    "scripts/**/*",
    "test/e2e/**/*",
    "test/unit/**/*"
  ]
}
