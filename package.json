{
  "name": "ynotpdf",
  "productName": "ynotPDF",
  "version": "0.0.1",
  "description": "Cross-platform PDF editor (Electron + TypeScript + PDFium).",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": {
    "name": "Ynot Apps",
    "email": "tonybaynes@gmail.com",
    "url": "https://ynot-apps.com"
  },
  "homepage": "https://ynot-apps.com",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky .githooks",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check . && node scripts/check-styles.ts && node scripts/extract-i18n.ts --check && node scripts/make-icon.ts && npm run typecheck",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "fixtures": "node scripts/make-fixtures.ts",
    "stamps": "node --import ./scripts/lib/register-ts.mjs scripts/make-stamps.ts",
    "fetch-binaries": "node scripts/fetch-binaries.ts",
    "licenses": "node scripts/check-licenses.ts",
    "package": "npm run build && electron-builder --publish never",
    "postinstall": "install-electron",
    "icon": "node scripts/make-icon.ts",
    "gallery": "vite src/renderer/theme --host 127.0.0.1 --port 5199 --strictPort --open /gallery.html",
    "fetch-fixtures": "node scripts/fetch-fixtures.ts",
    "bench": "node scripts/bench-engine.ts",
    "hashes": "node scripts/update-render-hashes.ts",
    "i18n": "node scripts/extract-i18n.ts"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "chokidar": "^4.0.3",
    "electron-store": "^11.0.2",
    "fast-xml-parser": "^5.11.1",
    "jpeg-js": "^0.4.4",
    "marked": "^16.4.2",
    "node-forge": "^1.4.0",
    "pako": "^1.0.11",
    "pdf-lib": "1.17.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.0",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^1.0.7",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.5.0",
    "lucide": "^1.42.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
