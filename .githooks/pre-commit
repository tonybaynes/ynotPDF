#!/usr/bin/env sh
# ynotPDF pre-commit hook (M00).
# 1. Refuse secrets, certificates, binaries and real PDFs.
# 2. Run lint-staged (eslint + prettier on the staged files).
#
# Installed by `npm run prepare` (husky points core.hooksPath at .githooks/_).
# Tested by test/unit/precommit.test.ts.

set -e

fail=0
say() { printf '%s\n' "$*" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)

for f in $staged; do
  case "$f" in
    *.p12|*.pfx|*.key|*.pem|*.jks|*.keystore)
      say "pre-commit: REFUSED certificate/private key: $f"; fail=1 ;;
    .env|.env.*|*/.env|*/.env.*)
      say "pre-commit: REFUSED environment file (secrets): $f"; fail=1 ;;
    *.pdf)
      case "$f" in
        test/fixtures/*) ;;
        *) say "pre-commit: REFUSED PDF outside test/fixtures/: $f"; fail=1 ;;
      esac ;;
    resources/bin/*)
      case "$f" in
        resources/bin/README.md) ;;
        *) say "pre-commit: REFUSED fetched binary under resources/bin/: $f"; fail=1 ;;
      esac ;;
    *.exe|*.dll|*.so|*.dylib|*.node|*.wasm|*.zip|*.7z|*.tar|*.gz|*.dmg|*.msi|*.deb|*.rpm|*.AppImage)
      say "pre-commit: REFUSED binary artefact: $f"; fail=1 ;;
  esac

  # Size guard (5 MB) — fixtures must stay small and synthetic.
  if git cat-file -e ":$f" 2>/dev/null; then
    size=$(git cat-file -s ":$f")
    if [ "$size" -gt 5242880 ]; then
      say "pre-commit: REFUSED file larger than 5 MB: $f ($size bytes)"; fail=1
    fi
  fi
done

# Secret patterns inside staged text content.
if [ -n "$staged" ]; then
  if git diff --cached -U0 -- $staged | grep -E '^\+' | grep -E -q \
      -e '-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----' \
      -e 'gh[pousr]_[A-Za-z0-9]{36}' \
      -e 'github_pat_[A-Za-z0-9_]{80,}' \
      -e 'AKIA[0-9A-Z]{16}' \
      -e 'sk-(ant-)?[A-Za-z0-9_-]{24,}' \
      -e 'xox[baprs]-[A-Za-z0-9-]{10,}'; then
    say "pre-commit: REFUSED staged content that looks like a secret (private key / API token)."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  say "pre-commit: commit blocked. Remove the offending file(s) from the index and retry."
  exit 1
fi

# Formatting / lint on staged files (skipped when node_modules is absent, e.g. in hook tests).
if [ -z "$YNOT_SKIP_LINT_STAGED" ] && [ -f node_modules/.bin/lint-staged ]; then
  npx --no-install lint-staged
fi
